# Backend Laravel - Copia esto a .env y reemplaza con tus valores reales

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-YOUR_ACCESS_TOKEN_HERE
MERCADOPAGO_PUBLIC_KEY=APP_USR-YOUR_PUBLIC_KEY_HERE

# URL del aplicación para webhooks
APP_URL=http://localhost:8000
